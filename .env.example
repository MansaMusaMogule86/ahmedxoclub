# ---------------------------------------------------------------------------
# XO Club Dubai / ahmedxoclub.com — environment template
# Copy to `.env` on the server (never commit the real `.env`).
#
#   cp .env.example .env && nano .env
# ---------------------------------------------------------------------------

# Prisma / SQLite.
# PRODUCTION: use an ABSOLUTE path inside the app directory — relative `file:`
# URLs are resolved differently by `prisma db push` (schema-relative) and by the
# running server (cwd-relative), which causes "Unable to open the database file".
# Replace uXXXXXXXXX with your Hostinger username.
DATABASE_URL="file:/home/uXXXXXXXXX/domains/ahmedxoclub.com/app/db/custom.db"

# Runtime (only needed if your process manager does not set them).
NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1

# Optional: bump if Next needs more heap during `next build`.
# NODE_OPTIONS=--max-old-space-size=2048
