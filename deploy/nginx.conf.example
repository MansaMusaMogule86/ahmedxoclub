# ---------------------------------------------------------------------------
# XO Club Dubai — nginx reverse proxy (Hostinger VPS)
#
# Copy to your server nginx config, e.g.
#   /etc/nginx/sites-available/ahmedxoclub.com
# then:  ln -s /etc/nginx/sites-available/ahmedxoclub.com /etc/nginx/sites-enabled/
#        nginx -t && systemctl reload nginx
#
# Assumes the Next.js standalone server runs on 127.0.0.1:3000 via PM2.
# Replace the root path with your own (e.g. /home/uXXXXXXXXX/domains/ahmedxoclub.com/app).
# ---------------------------------------------------------------------------

upstream xo_club_app {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name ahmedxoclub.com www.ahmedxoclub.com;

    # Hostinger's hPanel issues the certificate; set it up after DNS is live.
    # Certbot / hPanel will typically insert the 443 server block for you.

    # --- size / timeouts (the hero MP4 is ~39 MB) ---
    client_max_body_size 64m;
    proxy_read_timeout 120s;
    proxy_connect_timeout 30s;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json
               application/xml image/svg+xml application/manifest+json;

    # --- permanently cache immutable Next build assets (content-hashed) ---
    location /_next/static/ {
        proxy_pass http://xo_club_app;
        proxy_cache_valid 200 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # --- long-cache large media that is not content-hashed ---
    location ~* ^/(videos|images)/.+\.(mp4|webm|webp|png|jpe?g|svg|avif)$ {
        proxy_pass http://xo_club_app;
        add_header Cache-Control "public, max-age=604800";
    }

    # --- retired competitor-comparison URLs must return HTTP 410 ---
    # The app handles this in src/proxy.ts; keep the request flowing to the app
    # so the 410 (and its noindex header) is produced by the application.
    location / {
        proxy_pass http://xo_club_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_cache_bypass $http_upgrade;
    }
}
